<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="inertial_macros">
  <!-- Inertie d'un cylindre (axe longitudinal Z) -->
  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1.0/12.0)*mass*(3*radius*radius + length*length)}"
        iyy="${(1.0/12.0)*mass*(3*radius*radius + length*length)}"
        izz="${0.5*mass*radius*radius}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- Inertie d'une boîte axis-aligned -->
  <xacro:macro name="inertial_box" params="mass sx sy sz *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1.0/12.0)*mass*(sy*sy + sz*sz)}"
        iyy="${(1.0/12.0)*mass*(sx*sx + sz*sz)}"
        izz="${(1.0/12.0)*mass*(sx*sx + sy*sy)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>
</robot>